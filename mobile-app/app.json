{
  "expo": {
    "name": "Mantenimiento U",
    "slug": "mantenimiento-u",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "mx.edu.mantenimientou",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"],
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#173b67" }
    },
    "plugins": [
      ["expo-image-picker", {"photosPermission": "Permite seleccionar evidencia fotográfica para el reporte.", "cameraPermission": "Permite tomar evidencia fotográfica del problema."}],
      ["expo-secure-store", {"configureAndroidBackup": true}]
    ],
    "extra": { "apiUrl": "https://mantenimiento-u-actividad22.onrender.com/api" }
  }
}
